<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is DISABLED for direct distribution (non-App Store).
         This is required because CGEvent.post() to other apps needs
         Accessibility permission granted by the user in System Settings,
         which only works reliably outside the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Microphone access (required even without sandbox under Hardened Runtime) -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Outgoing network connections for Ollama on localhost:11434 -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
